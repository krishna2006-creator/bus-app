# Railway Environment Variables - COPY THESE INTO RAILWAY DASHBOARD
# Go to Railway → Your Backend Service → Variables → New Variable

# ==================
# DATABASE - CRITICAL FIX
# ==================
# IN RAILWAY DASHBOARD:
# 1. Click on PostgreSQL service
# 2. Click "Connect" tab
# 3. Copy the DATABASE_URL shown there
# 4. OR use variable reference: ${{Postgres.DATABASE_URL}}
#
# Example format:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@HOST:5432/railway
DATABASE_URL="${{Postgres.DATABASE_URL}}"

# ==================
# BASIC SETTINGS
# ==================
ENVIRONMENT="production"
SECRET_KEY="abc123def456ghi789jkl012mno345pqrs678tuv901wxy234zab567cde890fgh123"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
WORKERS="2"
LOG_LEVEL="info"

# ==================
# CORS - Leave empty for now, add after Firebase deploy
# ==================
CORS_ORIGINS=""

# ==================
# OPTIONAL - Skip these if not using
# ==================
# FCM_SERVER_KEY=
# FCM_PROJECT_ID=bustracker-afb3c
# FCM_SENDER_ID=851331446616
# REDIS_URL=redis://localhost:6379
