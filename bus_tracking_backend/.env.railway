# Railway Environment Variables - COPY THESE INTO RAILWAY DASHBOARD
# Go to Railway → Your Backend Service → Variables → New Variable

# ==================
# DATABASE - YOUR ACTUAL URL
# ==================
DATABASE_URL=postgresql://postgres:VxHIPzjROjWkgbtvhxpBSWOMIKfdmjCU@postgres.railway.internal:5432/railway

# ==================
# BASIC SETTINGS
# ==================
ENVIRONMENT="production"
SECRET_KEY="abc123def456ghi789jkl012mno345pqrs678tuv901wxy234zab567cde890fgh123"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
WORKERS="2"
LOG_LEVEL="info"

# ==================
# CORS - Allow all for now
# ==================
CORS_ORIGINS="*"

# ==================
# FIREBASE / FCM CONFIGURATION - REQUIRED for push notifications & Firestore
# ==================
# Paste the full JSON content of your firebase-key.json here.
# (Copy everything between the opening { and closing } of the service account JSON)
# In Railway Dashboard: Variables → New Variable → Name: FIREBASE_KEY → Value: <full JSON>
# FIREBASE_KEY={"type":"service_account","project_id":"bustracker-afb3c",...}

# Alternative: set FIREBASE_CREDENTIALS_PATH if you prefer file-based auth
# FIREBASE_CREDENTIALS_PATH=firebase-key.json

# ==================
# OPTIONAL - Skip these if not using
# ==================
# FCM_SERVER_KEY=
# FCM_PROJECT_ID=bustracker-afb3c
# FCM_SENDER_ID=851331446616
# REDIS_URL=redis://localhost:6379