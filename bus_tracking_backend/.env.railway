# Railway Environment Variables - COPY THESE INTO RAILWAY DASHBOARD
# Go to Railway → Your Backend Service → Variables → New Variable

# ==================
# DATABASE - USE PUBLIC URL (NOT INTERNAL)
# ==================
# In Railway Dashboard:
# 1. Click on PostgreSQL service
# 2. Click "Connect" tab
# 3. Copy the PUBLIC URL (starts with containers-us-west-xxx.railway.app)
# 4. Paste it below
DATABASE_URL=postgresql://postgres:VxHIPzjROjWkgbtvhxpBSWOMIKfdmjCU@containers-us-west-xxx.railway.app:5432/railway

# ==================
# BASIC SETTINGS
# ==================
ENVIRONMENT="production"
SECRET_KEY="abc123def456ghi789jkl012mno345pqrs678tuv901wxy234zab567cde890fgh123"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
WORKERS="2"
LOG_LEVEL="info"

# ==================
# CORS
# ==================
CORS_ORIGINS="*"

# ==================
# FIREBASE / FCM CONFIGURATION - REQUIRED
# ==================
# Paste the full JSON content of your firebase-key.json here.
# FIREBASE_KEY={"type":"service_account","project_id":"bustracker-afb3c",...}

# ==================
# OPTIONAL
# ==================
# FCM_SERVER_KEY=
# FCM_PROJECT_ID=bustracker-afb3c
# FCM_SENDER_ID=851331446616
# REDIS_URL=redis://localhost:6379